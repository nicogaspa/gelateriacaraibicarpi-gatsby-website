<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Canonical HTTPS www" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAny">
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{HTTP_HOST}" pattern="^www\.gelateriacaraibicarpi\.it$" negate="true" />
          </conditions>
          <action type="Redirect" url="https://www.gelateriacaraibicarpi.it/{R:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
    <staticContent>
      <remove fileExtension=".jsonl" />
      <mimeMap fileExtension=".jsonl" mimeType="application/x-ndjson" />
      <remove fileExtension=".tsv" />
      <mimeMap fileExtension=".tsv" mimeType="text/tab-separated-values" />
      <remove fileExtension=".csv" />
      <mimeMap fileExtension=".csv" mimeType="text/csv" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".avif" />
      <mimeMap fileExtension=".avif" mimeType="image/avif" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>
  </system.webServer>
  <location path="media">
    <system.webServer>
      <!-- I nomi delle immagini includono un hash: una nuova immagine produce un nuovo URL. -->
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
  <system.web>
    <!-- Percorso richiesto dall'hosting Aruba, preservato dalla configurazione di produzione. -->
    <compilation tempDirectory="D:\AspNetTemp\site\gelateriacaraibicarpi.it" />
  </system.web>
</configuration>
